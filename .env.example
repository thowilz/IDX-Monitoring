# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Loaded by your shell/cron before running scripts/run_refresh.py.

# Free FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html).
# Used for the OECD/IMF proxies in idr_stress (sbn10y, reserves).
# Without it those indicators correctly report STALE — never a guess.
FRED_API_KEY=

# Optional: Alpha Vantage / other free keys can be added here as modules grow.
# ALPHAVANTAGE_API_KEY=
